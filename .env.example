# Copy to .env.local for local development. Not committed (.gitignore).

# Where sanchay-api's server-authoritative endpoints live.
NEXT_PUBLIC_API_URL=http://localhost:8000

# From your Clerk dashboard (API Keys page).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Read directly by Clerk's own SDK (not validated in env.js) -- tells
# it where our dedicated /sign-in and /sign-up pages live, so the
# "Don't have an account? Sign up" cross-link inside the <SignIn />
# component (and vice versa) points at our own branded pages instead
# of Clerk's default hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
